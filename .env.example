# انسخ الملف ده لـ .env وعدّل القيم حسب استضافتك
PORT=8000
# أقصى حجم ملف بالميجابايت (افتراضي 2048 = 2 جيجا)
MAX_FILE_SIZE_MB=2048
# عدد التحميلات اللي بتشتغل في نفس الوقت
MAX_CONCURRENT_DOWNLOADS=2
# الملفات الجاهزة بتتمسح تلقائيًا بعد كام دقيقة
FILE_RETENTION_MINUTES=60
DATA_DIR=./data/tmp
# للاختبار المحلي فقط خلف بروكسي بيبدّل شهادات SSL (متسيبهاش 1 في الإنتاج أبدًا)
YTDLP_NO_CHECK_CERTIFICATE=0
